# ==========================================
# InterviewX DataHub Environment Configuration
# ==========================================

# ------------------------------------------
# General System & Ports
# ------------------------------------------
NODE_ENV=development
PORT_BACKEND=4000
PORT_FRONTEND=3000
PORT_AI_SERVICE=8000

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=interviewx
POSTGRES_PASSWORD=interviewx_secret
POSTGRES_DB=interviewx_datahub
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://interviewx:interviewx_secret@localhost:5432/interviewx_datahub?schema=public

# ------------------------------------------
# Redis (Queue & Caching)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# Object Storage (MinIO)
# ------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET_RAW_DOCUMENTS=raw-documents
MINIO_BUCKET_DATASET_EXPORTS=dataset-exports

# ------------------------------------------
# Authentication & Internal Security
# ------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_KEY=interviewx_internal_service_secret_key_2026

# ------------------------------------------
# AI Service & External Providers
# ------------------------------------------
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------
# MLflow Tracking
# ------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5001

# ------------------------------------------
# Frontend Public Variables
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
