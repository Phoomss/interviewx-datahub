datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  ML_ENGINEER
  ANNOTATOR
  VIEWER
}

enum DocumentClassification {
  RESUME
  CV
  ACADEMIC_CV
  PORTFOLIO
  TRANSCRIPT
  CERTIFICATE
  RECOMMENDATION_LETTER
  RESEARCH_PAPER
  PROJECT_REPORT
  EMPLOYMENT_DOCUMENT
  SCHOLARSHIP_DOCUMENT
  TRAINING_RECORD
  OTHER
}

enum TrainingEligibilityStatus {
  EXTRACTION_PENDING
  EXTRACTION_COMPLETED
  AWAITING_REVIEW
  REVIEWED
  APPROVED_FOR_PROFILE_MANAGEMENT
  APPROVED_FOR_DATASET_PREPARATION
  APPROVED_FOR_TRAINING
  RESTRICTED
  CONSENT_WITHDRAWN
  REJECTED
  DELETION_PENDING
  DELETED
}

enum ConsentStatus {
  ACTIVE
  WITHDRAWN
  EXPIRED
  SUSPENDED
}

enum LegalBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  VITAL_INTERESTS
  PUBLIC_TASK
  LEGITIMATE_INTERESTS
}

enum VerificationStatus {
  PENDING_REVIEW
  HUMAN_VERIFIED
  AI_INFERRED
  CORRECTED
  REJECTED
}

enum MalwareScanStatus {
  CLEAN
  INFECTED
  SUSPICIOUS
  PENDING
  SKIPPED
}

enum DocumentStatus {
  UPLOADED
  PARSING
  PARSED
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  PARSE_FAILED
}

enum SourceType {
  SYNTHETIC
  REAL_AUTHORIZED
  PARTNER
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ExportFormat {
  ALPACA
  SHAREGPT
  CHATML
  EMBEDDING
  JSON
  JSONL
  CSV
  XLSX
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String             @map("password_hash")
  fullName      String             @map("full_name")
  role          UserRole           @default(ANNOTATOR)
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  documents     Document[]         @relation("UserDocuments")
  reviews       AnnotationReview[]
  syntheticJobs SyntheticJob[]
  datasetExports DatasetExport[]
  auditLogs     AuditLog[]

  @@map("users")
}

model ConsentRecord {
  id                            String                       @id @default(uuid())
  subjectIdentifier             String                       @map("subject_identifier")
  consentVersion                String                       @default("1.0") @map("consent_version")
  consentType                   String                       @map("consent_type")
  legalBasis                    LegalBasis                   @default(CONSENT) @map("legal_basis")
  status                        ConsentStatus                @default(ACTIVE)
  permittedPurposes             Json?                        @map("permitted_purposes") // string[] of authorized purposes
  permittedDataCategories       Json?                        @map("permitted_data_categories") // string[] of document classifications
  permittedProcessingActivities  Json?                        @map("permitted_processing_activities") // string[] of processing operations
  agreementDocumentUrl          String?                      @map("agreement_document_url")
  evidenceReference             String?                      @map("evidence_reference")
  collectionMethod              String?                      @map("collection_method")
  isActive                      Boolean                      @default(true) @map("is_active")
  grantedAt                     DateTime                     @default(now()) @map("granted_at")
  expiresAt                     DateTime?                    @map("expires_at")
  revokedAt                     DateTime?                    @map("revoked_at")
  withdrawnAt                   DateTime?                    @map("withdrawn_at")
  createdAt                     DateTime                     @default(now()) @map("created_at")
  updatedAt                     DateTime                     @updatedAt @default(now()) @map("updated_at")

  documents                     Document[]
  consentHistories              ConsentHistory[]
  authorizationLogs             ProcessingAuthorizationLog[]

  @@index([subjectIdentifier])
  @@index([status, isActive])
  @@map("consent_records")
}

model ConsentHistory {
  id            String        @id @default(uuid())
  consentId     String        @map("consent_id")
  action        String        // GRANTED, UPDATED, WITHDRAWN, EXPIRED, SUSPENDED
  previousState Json?         @map("previous_state")
  newState      Json?         @map("new_state")
  reason        String?       @db.Text
  actorId       String?       @map("actor_id")
  actorIp       String?       @map("actor_ip")
  createdAt     DateTime      @default(now()) @map("created_at")

  consent       ConsentRecord @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId, createdAt(sort: Desc)])
  @@map("consent_history")
}

model ProcessingAuthorizationLog {
  id             String         @id @default(uuid())
  consentId      String?        @map("consent_id")
  documentId     String?        @map("document_id")
  subjectId      String?        @map("subject_id")
  purpose        String
  activity       String
  dataCategory   String?        @map("data_category")
  isAuthorized   Boolean        @map("is_authorized")
  decisionCode   String         @map("decision_code") // PERMITTED, PURPOSE_NOT_GRANTED, CONSENT_EXPIRED, CONSENT_WITHDRAWN, CATEGORY_RESTRICTED, SUBJECT_UNKNOWN
  decisionReason String         @map("decision_reason") @db.Text
  evaluatedAt    DateTime       @default(now()) @map("evaluated_at")
  ipAddress      String?        @map("ip_address")
  actorId        String?        @map("actor_id")

  consent        ConsentRecord? @relation(fields: [consentId], references: [id], onDelete: SetNull)
  document       Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([consentId])
  @@index([documentId])
  @@index([evaluatedAt(sort: Desc)])
  @@map("processing_authorization_logs")
}

model Document {
  id                         String                    @id @default(uuid())
  fileName                   String                    @map("file_name")
  originalFilename           String?                   @map("original_filename")
  fileType                   String                    @map("file_type") // PDF, DOCX, PNG, JPG, XLSX, PPTX
  detectedMimeType           String?                   @map("detected_mime_type")
  fileExtension              String?                   @map("file_extension")
  fileSizeBytes              Int                       @map("file_size_bytes")
  checksumSha256             String?                   @map("checksum_sha256")
  storagePath                String                    @map("storage_path") // MinIO object key
  sourceType                 SourceType                @default(SYNTHETIC) @map("source_type")
  isSynthetic                Boolean                   @default(true) @map("is_synthetic")
  status                     DocumentStatus            @default(UPLOADED)
  classification             DocumentClassification    @default(RESUME)
  classificationConfidence   Float?                    @map("classification_confidence")
  language                   String?                   @default("en")
  pageCount                  Int?                      @default(1) @map("page_count")
  malwareScanStatus          MalwareScanStatus         @default(CLEAN) @map("malware_scan_status")
  trainingEligibilityStatus  TrainingEligibilityStatus @default(EXTRACTION_PENDING) @map("training_eligibility_status")
  trainingEligibilityReason  String?                   @map("training_eligibility_reason") @db.Text
  subjectId                  String?                   @map("subject_id") // pseudonymous subject ID (e.g. SUBJ-XXXX)

  consentId                  String?                   @map("consent_id")
  uploadedById               String?                   @map("uploaded_by_id")
  syntheticJobId             String?                   @map("synthetic_job_id")

  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  deletedAt                  DateTime?                 @map("deleted_at")

  consent                    ConsentRecord?            @relation(fields: [consentId], references: [id], onDelete: SetNull)
  uploadedBy                 User?                     @relation("UserDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  syntheticJob               SyntheticJob?             @relation(fields: [syntheticJobId], references: [id], onDelete: SetNull)

  parsedProfile              ParsedProfile?
  piiVault                   PiiVault?
  reviews                    AnnotationReview[]
  pages                      DocumentPage[]
  sections                   DocumentSection[]
  provenances                FieldProvenanceRecord[]
  qualityValidation          DocumentQualityValidation?
  authorizationLogs          ProcessingAuthorizationLog[]

  @@index([status, isSynthetic])
  @@index([classification])
  @@index([trainingEligibilityStatus])
  @@index([subjectId])
  @@index([createdAt(sort: Desc)])
  @@map("documents")
}

model PiiVault {
  id               String        @id @default(uuid())
  documentId       String        @unique @map("document_id")
  subjectId        String?       @map("subject_id")
  fullName         String?       @map("full_name")
  email            String?
  phoneNumber      String?       @map("phone_number")
  address          String?
  nationalId       String?       @map("national_id")
  dateOfBirth      DateTime?     @map("date_of_birth")
  passportNumber   String?       @map("passport_number")
  sensitiveData    Json?         @map("sensitive_data") // other sensitive fields classification
  encryptedPayload String?       @map("encrypted_payload") @db.Text // AES-256-GCM ciphertext
  encryptionKeyId  String?       @default("vault-master-k1") @map("encryption_key_id")
  isPurged         Boolean       @default(false) @map("is_purged")
  retentionUntil   DateTime?     @map("retention_until")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  document         Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accessLogs       PiiAccessLog[]

  @@index([subjectId])
  @@map("pii_vault")
}

model PiiAccessLog {
  id              String   @id @default(uuid())
  vaultId         String   @map("vault_id")
  documentId      String   @map("document_id")
  actorId         String?  @map("actor_id")
  actorRole       String   @map("actor_role")
  purpose         String
  fieldsRequested Json     @map("fields_requested")
  accessDecision  String   @map("access_decision") // GRANTED, DENIED_ROLE, DENIED_CONSENT
  ipAddress       String?  @map("ip_address")
  accessedAt      DateTime @default(now()) @map("accessed_at")

  vault           PiiVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId, accessedAt(sort: Desc)])
  @@index([documentId])
  @@map("pii_access_logs")
}

model DocumentPage {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  pageNumber    Int      @map("page_number")
  pageText      String   @map("page_text") @db.Text
  ocrApplied    Boolean  @default(false) @map("ocr_applied")
  ocrConfidence Float?   @map("ocr_confidence")
  tablesJson    Json?    @map("tables_json")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@map("document_pages")
}

model DocumentSection {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  sectionName String   @map("section_name")
  rawContent  String   @map("raw_content") @db.Text
  startPage   Int      @default(1) @map("start_page")
  endPage     Int      @default(1) @map("end_page")
  createdAt   DateTime @default(now()) @map("created_at")

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_sections")
}

model FieldProvenanceRecord {
  id                 String             @id @default(uuid())
  documentId         String             @map("document_id")
  fieldPath          String             @map("field_path")
  extractedValue     String             @map("extracted_value") @db.Text
  normalizedValue    String?            @map("normalized_value") @db.Text
  pageNumber         Int?               @map("page_number")
  sectionName        String?            @map("section_name")
  paragraphRef       String?            @map("paragraph_ref")
  textStartOffset    Int?               @map("text_start_offset")
  textEndOffset      Int?               @map("text_end_offset")
  sourceText         String?            @map("source_text") @db.Text
  extractionMethod   String             @default("text_segmentation") @map("extraction_method")
  confidenceScore    Float              @default(0.9) @map("confidence_score")
  verificationStatus VerificationStatus @default(PENDING_REVIEW) @map("verification_status")
  isAiInferred       Boolean            @default(false) @map("is_ai_inferred")
  isIncomplete       Boolean            @default(false) @map("is_incomplete")
  reviewerId         String?            @map("reviewer_id")
  reviewedAt         DateTime?          @map("reviewed_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  document           Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, fieldPath])
  @@map("field_provenances")
}

model DocumentQualityValidation {
  id                        String   @id @default(uuid())
  documentId                String   @unique @map("document_id")
  overallScore              Float    @default(0.0) @map("overall_score")
  fileIntegrityValid        Boolean  @default(true) @map("file_integrity_valid")
  extractionCompleteness    Float    @default(0.0) @map("extraction_completeness")
  ocrConfidenceAvg          Float    @default(1.0) @map("ocr_confidence_avg")
  timelineConsistency       Boolean  @default(true) @map("timeline_consistency")
  crossDocumentConsistency  Boolean  @default(true) @map("cross_document_consistency")
  validationIssues          Json?    @map("validation_issues")
  validatedAt               DateTime @default(now()) @map("validated_at")

  document                  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_quality_validations")
}

model ParsedProfile {
  id               String   @id @default(uuid())
  documentId       String   @unique @map("document_id")
  rawText          String?  @map("raw_text") @db.Text
  structuredData   Json     @map("structured_data") // Summary, Skills, Experiences, Education
  provenance       Json?    // Text offsets and confidence per field
  confidenceScore  Float?   @map("confidence_score")
  extractorVersion String?  @map("extractor_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("parsed_profiles")
}

model AnnotationReview {
  id           String    @id @default(uuid())
  documentId   String    @map("document_id")
  reviewerId   String    @map("reviewer_id")
  status       String    // APPROVED, REJECTED, NEEDS_CORRECTION
  corrections  Json?     // Field diffs and manual edits
  reviewNotes  String?   @map("review_notes") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer     User      @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@map("annotation_reviews")
}

model SyntheticJob {
  id               String     @id @default(uuid())
  jobName          String     @map("job_name")
  createdById      String     @map("created_by_id")
  status           JobStatus  @default(QUEUED)
  targetCount      Int        @map("target_count")
  generatedCount   Int        @default(0) @map("generated_count")
  generationConfig Json       @map("generation_config")
  failureReason    String?    @map("failure_reason") @db.Text
  startedAt        DateTime?  @map("started_at")
  completedAt      DateTime?  @map("completed_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  createdBy        User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  documents        Document[]
  datasetRecords   DatasetRecord[]

  @@map("synthetic_jobs")
}

model DatasetExport {
  id             String       @id @default(uuid())
  exportName     String       @map("export_name")
  createdById    String       @map("created_by_id")
  exportFormat   ExportFormat @map("export_format")
  status         JobStatus    @default(QUEUED)
  recordCount    Int          @default(0) @map("record_count")
  storagePath    String?      @map("storage_path")
  filterCriteria Json         @map("filter_criteria")
  dvcHash        String?      @map("dvc_hash")
  mlflowRunId    String?      @map("mlflow_run_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  completedAt    DateTime?    @map("completed_at")

  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("dataset_exports")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String   // CREATE, UPDATE, DELETE, EXPORT, CONSENT_REVOKE
  entityName  String   @map("entity_name")
  entityId    String   @map("entity_id")
  ipAddress   String?  @map("ip_address")
  payloadDiff Json?    @map("payload_diff")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Industry {
  id                  String               @id @default(uuid())
  key                 String               @unique
  name                String
  nameTh              String?              @map("name_th")
  description         String?              @db.Text
  icon                String?
  isCustom            Boolean              @default(false) @map("is_custom")
  createdAt           DateTime             @default(now()) @map("created_at")

  professions         Profession[]
  industryProfessions IndustryProfession[]
  datasetRecords      DatasetRecord[]

  @@map("industries")
}

model Profession {
  id                       String                        @id @default(uuid())
  industryId               String?                       @map("industry_id")
  key                      String
  name                     String
  nameTh                   String?                       @map("name_th")
  description              String?                       @db.Text
  suggestedSkills          Json?                         @map("suggested_skills")
  professionSpecificFields Json?                         @map("profession_specific_fields")
  isCustom                 Boolean                       @default(false) @map("is_custom")
  createdAt                DateTime                      @default(now()) @map("created_at")

  industry                 Industry?                     @relation(fields: [industryId], references: [id], onDelete: SetNull)
  industryProfessions      IndustryProfession[]
  professionSkills         ProfessionSkill[]
  interviewCategories      ProfessionInterviewCategory[]
  datasetRecords           DatasetRecord[]

  @@unique([key])
  @@map("professions")
}

model InterviewCategory {
  id                   String                        @id @default(uuid())
  key                  String                        @unique
  name                 String
  nameTh               String?                       @map("name_th")
  description          String?                       @db.Text
  subcategories        Json                          // string[] or { key, name, nameTh }[]
  isCustom             Boolean                       @default(false) @map("is_custom")
  createdAt            DateTime                      @default(now()) @map("created_at")

  professionCategories ProfessionInterviewCategory[]
  categoryFormats      InterviewCategoryFormat[]

  @@map("interview_categories")
}

model InterviewFormat {
  id              String                    @id @default(uuid())
  key             String                    @unique
  name            String
  nameTh          String?                   @map("name_th")
  description     String?                   @db.Text
  isCustom        Boolean                   @default(false) @map("is_custom")
  createdAt       DateTime                  @default(now()) @map("created_at")

  categoryFormats InterviewCategoryFormat[]

  @@map("interview_formats")
}

model SeniorityLevel {
  id          String   @id @default(uuid())
  category    String   // career, academic, healthcare_licensed
  key         String   @unique
  name        String
  nameTh      String?  @map("name_th")
  minYearsExp Float?   @map("min_years_exp")
  maxYearsExp Float?   @map("max_years_exp")
  isCustom    Boolean  @default(false) @map("is_custom")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("seniority_levels")
}

model SkillCategory {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  nameTh    String?  @map("name_th")
  createdAt DateTime @default(now()) @map("created_at")

  skills    Skill[]

  @@map("skill_categories")
}

model Skill {
  id                String            @id @default(uuid())
  categoryId        String            @map("category_id")
  name              String
  nameTh            String?           @map("name_th")
  description       String?           @db.Text
  proficiencyLevels Json?             @map("proficiency_levels")
  isCustom          Boolean           @default(false) @map("is_custom")
  createdAt         DateTime          @default(now()) @map("created_at")

  category          SkillCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  professionSkills  ProfessionSkill[]

  @@unique([categoryId, name])
  @@map("skills")
}

// ==========================================
// Many-to-Many Dynamic Taxonomy Join Tables
// ==========================================

model IndustryProfession {
  id           String     @id @default(uuid())
  industryId   String     @map("industry_id")
  professionId String     @map("profession_id")
  isPrimary    Boolean    @default(false) @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at")

  industry     Industry   @relation(fields: [industryId], references: [id], onDelete: Cascade)
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([industryId, professionId])
  @@index([professionId])
  @@map("industry_professions")
}

model ProfessionSkill {
  id           String     @id @default(uuid())
  professionId String     @map("profession_id")
  skillId      String     @map("skill_id")
  isCore       Boolean    @default(true) @map("is_core")
  relevance    Float      @default(1.0)
  createdAt    DateTime   @default(now()) @map("created_at")

  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([professionId, skillId])
  @@index([skillId])
  @@map("profession_skills")
}

model ProfessionInterviewCategory {
  id                  String            @id @default(uuid())
  professionId        String            @map("profession_id")
  interviewCategoryId String            @map("interview_category_id")
  relevance           Float             @default(1.0)
  createdAt           DateTime          @default(now()) @map("created_at")

  profession          Profession        @relation(fields: [professionId], references: [id], onDelete: Cascade)
  interviewCategory   InterviewCategory @relation(fields: [interviewCategoryId], references: [id], onDelete: Cascade)

  @@unique([professionId, interviewCategoryId])
  @@index([interviewCategoryId])
  @@map("profession_interview_categories")
}

model InterviewCategoryFormat {
  id                  String            @id @default(uuid())
  interviewCategoryId String            @map("interview_category_id")
  interviewFormatId   String            @map("interview_format_id")
  createdAt           DateTime          @default(now()) @map("created_at")

  interviewCategory   InterviewCategory @relation(fields: [interviewCategoryId], references: [id], onDelete: Cascade)
  interviewFormat     InterviewFormat   @relation(fields: [interviewFormatId], references: [id], onDelete: Cascade)

  @@unique([interviewCategoryId, interviewFormatId])
  @@index([interviewFormatId])
  @@map("interview_category_formats")
}

model DatasetRecord {
  id                   String        @id @default(uuid())
  jobId                String?       @map("job_id")
  datasetType          String        @map("dataset_type") // profile, resume, interview_question, interview_answer, rubric_evaluation, feedback, scenario
  industryId           String?       @map("industry_id")
  professionId         String?       @map("profession_id")
  interviewCategory    String?       @map("interview_category")
  interviewSubcategory String?       @map("interview_subcategory")
  seniorityLevel       String?       @map("seniority_level")
  language             String        @default("en")
  isSynthetic          Boolean       @default(true) @map("is_synthetic")
  content              Json          @db.JsonB
  qualityStatus        String        @default("VERIFIED") @map("quality_status") // VERIFIED, PENDING_REVIEW, NEEDS_REVISION, REJECTED
  validationResult     Json?         @map("validation_result")
  metadata             Json?         @db.JsonB
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  syntheticJob         SyntheticJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  industry             Industry?     @relation(fields: [industryId], references: [id], onDelete: SetNull)
  profession           Profession?   @relation(fields: [professionId], references: [id], onDelete: SetNull)

  @@index([datasetType, industryId, professionId])
  @@index([qualityStatus])
  @@index([createdAt(sort: Desc)])
  @@map("dataset_records")
}
